# AI Fund Research Stack — Environment Variables
# Copy to .env and fill in your keys. Never commit .env to git.

# FRED API (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Anthropic / Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NewsAPI (free tier: https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# Reddit / PRAW (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ai-fund-research/1.0

# Quiver Quant (free tier: https://www.quiverquant.com/)
QUIVER_API_KEY=your_quiver_api_key_here

# Financial Modeling Prep (earnings transcripts, https://financialmodelingprep.com/)
FMP_API_KEY=your_fmp_api_key_here

# Database path (default: ./data/fund.duckdb)
DUCKDB_PATH=./data/fund.duckdb

# Parquet staging directory (default: ./data/parquet)
PARQUET_DIR=./data/parquet

# Reports output directory
REPORTS_DIR=./reports

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Daily Claude API extraction budget (USD)
CLAUDE_DAILY_BUDGET_USD=5.0
